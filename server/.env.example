# Supabase Dashboard > Connect > ORMs > TypeORM, or use the pooled connection string.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Supabase Dashboard > Project Settings > API. This is safe to expose in a browser.
# If the project only has a legacy anon key, use its value here.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR-PUBLISHABLE-KEY]
# Keep this server-only key secret. It is used for journal image uploads.
SUPABASE_SERVICE_ROLE_KEY=service_role_[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=journal-images
SUPABASE_JWT_AUDIENCE=authenticated
PORT=3000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
